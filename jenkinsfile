pipeline {
  agent any

  environment {
    IMAGE_NAME = 'devops-react-app'
    DEV_REPO = 'gokul603/devops-react-dev'
    PROD_REPO = 'gokul603/devops-react-prod'
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: "${env.BRANCH_NAME}", url: 'https://github.com/YOUR_USERNAME/YOUR_REPO.git'
      }
    }

    stage('Build Docker Image') {
      steps {
        sh './build.sh'
      }
    }

    stage('Push to DockerHub') {
      steps {
        script {
          docker.withRegistry('', 'dockerhub-credentials-id') {
            if (env.BRANCH_NAME == 'dev') {
              sh "docker tag ${IMAGE_NAME} ${DEV_REPO}"
              sh "docker push ${DEV_REPO}"
            } else if (env.BRANCH_NAME == 'master') {
              sh "docker tag ${IMAGE_NAME} ${PROD_REPO}"
              sh "docker push ${PROD_REPO}"
            }
          }
        }
      }
    }

    stage('Deploy') {
      steps {
        sh './deploy.sh'
      }
    }
  }
}
